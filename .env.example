# SA password for the local SQL Server container (docker-compose.yml).
# SQL Server requires 8+ characters with 3 of: uppercase, lowercase, digits, symbols.
# Must match the Password in your User Secrets connection string.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!
