@page "/admin/applications/{Id:int}"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using EventBooking.Core
@using EventBooking.Web.Data
@using EventBooking.Web.Services
@using EventBooking.Web.Components.Account
@using EventBooking.Web.Components.Account.Shared

@attribute [Authorize(Policy = AuthorizationPolicies.ReviewApplications)]

@inject UserManager<ApplicationUser> UserManager
@inject OrganiserApplicationService Applications
@inject IdentityRedirectManager RedirectManager

<PageTitle>Review application</PageTitle>

<h1>Review application</h1>

<StatusMessage Message="@errorMessage" />

@if (item is null)
{
    <p>This application doesn't exist.</p>
}
else
{
    var application = item.Application;
    <dl class="row">
        <dt class="col-sm-3">Organisation</dt>
        <dd class="col-sm-9">@application.OrganisationName</dd>
        <dt class="col-sm-3">Applicant</dt>
        <dd class="col-sm-9">@item.ApplicantEmail</dd>
        <dt class="col-sm-3">Contact phone</dt>
        <dd class="col-sm-9">@application.ContactPhone</dd>
        <dt class="col-sm-3">Website</dt>
        @* Text, not a link: it hasn't been checked. *@
        <dd class="col-sm-9">@(application.Website ?? "–")</dd>
        <dt class="col-sm-3">Why they're applying</dt>
        <dd class="col-sm-9" style="white-space: pre-line">@(application.Description ?? "–")</dd>
        <dt class="col-sm-3">Submitted (UTC)</dt>
        <dd class="col-sm-9">@application.SubmittedAt.UtcDateTime.ToString("d MMM yyyy HH:mm")</dd>
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
            @application.Status
            @if (application.RejectionReason is not null)
            {
                <text>: @application.RejectionReason</text>
            }
        </dd>
    </dl>

    @*
        Always rendered: Blazor needs the form to exist to handle a POST, or a decision made by
        another admin meanwhile gets a bare "400 Bad Request" instead of our error message.
    *@
    <div class="row">
        <div class="col-xl-6">
            <EditForm Model="Input" FormName="review-application" OnValidSubmit="ReviewAsync" method="post">
                @if (application.Status == ApplicationStatus.Pending)
                {
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" role="alert" />
                    <div class="form-floating mb-3">
                        <InputTextArea @bind-Value="Input.RejectionReason" id="Input.RejectionReason" class="form-control" style="height: 6rem" placeholder="Reason" />
                        <label for="Input.RejectionReason">Reason for rejecting (optional, shown to the applicant)</label>
                        <ValidationMessage For="() => Input.RejectionReason" class="text-danger" />
                    </div>
                    @* Both buttons submit the same form; the one clicked sends its value as Input.Decision. *@
                    <button type="submit" name="Input.Decision" value="@Decision.Approve" class="btn btn-success">Approve</button>
                    <button type="submit" name="Input.Decision" value="@Decision.Reject" class="btn btn-danger">Reject</button>
                }
            </EditForm>
        </div>
    </div>
}

<p class="mt-3"><a href="admin/applications">Back to applications</a></p>

@code {
    private string adminId = "";
    private ApplicationWithApplicant? item;
    private string? errorMessage;

    [Parameter]
    public int Id { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        // The [Authorize] attribute means there is always a signed-in user here.
        adminId = UserManager.GetUserId(HttpContext.User)!;
        item = await Applications.GetApplicationAsync(Id, adminId);
    }

    private async Task ReviewAsync()
    {
        string message;
        try
        {
            if (Input.Decision == Decision.Approve)
            {
                await Applications.ApproveAsync(Id, adminId);
                message = $"Approved {item?.Application.OrganisationName}. The applicant is now an organiser.";
            }
            else
            {
                await Applications.RejectAsync(Id, adminId, Input.RejectionReason);
                message = $"Rejected {item?.Application.OrganisationName}.";
            }
        }
        catch (BusinessRuleException ex)
        {
            errorMessage = "Error: " + ex.Message;
            return;
        }

        // Outside the try, because a redirect works by throwing an exception.
        RedirectManager.RedirectToWithStatus("admin/applications", message, HttpContext);
    }

    private enum Decision { Approve, Reject }

    private sealed class InputModel
    {
        public Decision Decision { get; set; }

        [StringLength(OrganiserApplication.RejectionReasonMaxLength)]
        [Display(Name = "Reason")]
        public string? RejectionReason { get; set; }
    }
}
